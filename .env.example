# Server-side settings. Copy to .env.local for `npm run dev`; on Vercel, set
# these under Project Settings → Environment Variables.

# Neon Postgres — the pooled connection string (host contains "-pooler").
DATABASE_URL=postgresql://user:password@ep-example-pooler.us-east-1.aws.neon.tech/aisle?sslmode=require

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Where the app is served: http://localhost:5173 locally, the production URL on Vercel.
BETTER_AUTH_URL=http://localhost:5173
# Optional: more origins allowed to sign in, comma-separated (e.g. a preview URL).
# BETTER_AUTH_TRUSTED_ORIGINS=

# Resend, for sign-in code emails. Without a key in development, codes are
# printed to the dev server log instead.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Aisle <hello@yourdomain.com>
