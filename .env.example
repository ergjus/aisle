# Every setting Aisle reads, and what you have to do by hand to get each one.
#
# Locally: copy this file to .env.local for `npm run dev`.
# On Vercel: set the same names under Project Settings → Environment Variables,
# for Production and (if you want previews to work) Preview, then redeploy;
# env changes only reach new deployments.
#
# Nothing here is needed to open the chart. Each block switches on one feature.

# ─── Built-in agent (api/agent.ts) ────────────────────────────────────────────
# Without a credential the agent stays hidden. Any one option is enough;
# locally, `ant auth login` also works with none.
#
# Option A: an API key. Get it at https://console.anthropic.com → API Keys.
# Set a monthly spend limit on its workspace: POST /api/agent is only
# rate-limited per IP until it is gated behind sign-in.
ANTHROPIC_API_KEY=

# Option B: workload identity federation with Vercel's OIDC token (no key).
# Create a federation rule and service account in the Anthropic Console,
# and turn on OIDC in Vercel → Settings → Security.
# ANTHROPIC_FEDERATION_RULE_ID=fdrl_...
# ANTHROPIC_ORGANIZATION_ID=...
# ANTHROPIC_SERVICE_ACCOUNT_ID=svac_...
# ANTHROPIC_WORKSPACE_ID=        # only if the rule covers several workspaces

# Optional overrides
# AISLE_AGENT_MODEL=claude-opus-5-5
# AISLE_AGENT_EFFORT=medium

# ─── Accounts: database (server/db) ───────────────────────────────────────────
# Neon console → project "aisle" → Connect → the pooled connection string
# (host contains "-pooler"). The auth tables already exist on the main branch;
# after changing server/db/schema.ts run `npm run db:generate` then
# `npm run db:migrate`.
DATABASE_URL=postgresql://user:password@ep-example-pooler.us-east-1.aws.neon.tech/aisle?sslmode=require

# ─── Accounts: sign-in (server/auth.ts, Better Auth) ──────────────────────────
# Generate with: openssl rand -base64 32. Use a different value per environment.
BETTER_AUTH_SECRET=
# Where the app is served: http://localhost:5173 locally, the production URL on Vercel.
BETTER_AUTH_URL=http://localhost:5173
# Optional: more origins allowed to sign in, comma-separated (e.g. a preview URL).
# BETTER_AUTH_TRUSTED_ORIGINS=

# ─── Accounts: sign-in code emails (Resend) ───────────────────────────────────
# https://resend.com → API Keys. Without a key in development, codes are
# printed to the dev server log instead.
RESEND_API_KEY=
# The sender. Its domain must be verified first: Resend → Domains → Add, then
# add the DNS records it shows at your registrar. Until then Resend only
# delivers to your own account's address.
RESEND_FROM_EMAIL=Aisle <hello@yourdomain.com>
